# ETI Research Core — Kaggle training and evaluation
# Run only when intentionally starting model fitting. This notebook trains
# from scratch using public OHLCV data; it does not place trades.
from pathlib import Path
import subprocess, sys

repo = Path('/kaggle/working/eti-research-core')
if not repo.exists():
    subprocess.run(['git', 'clone', '--branch', 'main',
                    'https://github.com/hamza00alik-source/eti-research-core.git',
                    str(repo)], check=True)
else:
    subprocess.run(['git', '-C', str(repo), 'pull', '--ff-only'], check=True)
%cd /kaggle/working/eti-research-core
%pip install -r requirements.txt

# Start with BTC and ETH spot OHLCV; each symbol is evaluated independently.
EXCHANGE = 'binance'
SYMBOLS = 'BTC/USDT,ETH/USDT'
TIMEFRAME = '1h'
CANDLE_LIMIT = 3000
OUTPUT = 'artifacts/eti_nested_walk_forward.json'

subprocess.run([
    sys.executable, '-m', 'eti.pipeline',
    '--exchange', EXCHANGE,
    '--symbols', SYMBOLS,
    '--timeframe', TIMEFRAME,
    '--limit', str(CANDLE_LIMIT),
    '--evaluation', 'nested',
    '--output', OUTPUT,
], check=True)
print(Path(OUTPUT).read_text())

