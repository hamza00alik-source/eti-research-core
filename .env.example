# Copy to .env on the host. Generate secrets locally; never commit real values.
ETI_AUTH_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_BYTES
ETI_REGISTRATION_KEY=REPLACE_WITH_PRIVATE_INVITE_KEY_AT_LEAST_16_CHARS
ETI_ADMIN_USERNAMES=
# URL-safe base64 of 32 random bytes; encrypts owner exchange credentials at rest.
ETI_CREDENTIAL_ENCRYPTION_KEY=
# Keep the API bound to localhost behind a TLS reverse proxy by default.
ETI_BIND_ADDRESS=127.0.0.1
ETI_PORT=8000

# Persistent data paths inside the container.
ETI_DATABASE_PATH=/app/data/eti.sqlite3
ETI_ARTIFACT_DIR=/app/data/artifacts

# Compose uses a separate worker container; keep embedded mode off there.
ETI_EMBEDDED_WORKER=0
ETI_WORKER_POLL_SECONDS=2
ETI_BACKUP_ENABLED=0
ETI_BACKUP_INTERVAL_SECONDS=86400
ETI_BACKUP_RETENTION_DAYS=30

# Optional S3-compatible encrypted backups. Fill ALL required values before enabling.
ETI_BACKUP_S3_ENDPOINT=
ETI_BACKUP_S3_BUCKET=
ETI_BACKUP_S3_ACCESS_KEY_ID=
ETI_BACKUP_S3_SECRET_ACCESS_KEY=
ETI_BACKUP_S3_REGION=
ETI_BACKUP_S3_ADDRESSING_STYLE=path
ETI_BACKUP_S3_PREFIX=eti/sqlite
# Base64 encoding of a randomly generated 32-byte AES key. Keep it outside Git.
ETI_BACKUP_ENCRYPTION_KEY=
